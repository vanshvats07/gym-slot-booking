PORT=5000

MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/gym_slot_booking

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1d

SEED_ADMIN_EMAIL=admin@gym.local
SEED_ADMIN_PASSWORD=replace-with-a-private-admin-password
SEED_MEMBER_EMAIL=member@gym.local
SEED_MEMBER_PASSWORD=replace-with-a-private-member-password

ADMIN_RESET_PASSWORD=replace-with-a-private-password
